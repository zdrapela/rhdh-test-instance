export KEYCLOAK_CLIENT_SECRET=""
export KEYCLOAK_CLIENT_ID=""
export KEYCLOAK_REALM=""
export KEYCLOAK_LOGIN_REALM=""
export KEYCLOAK_METADATA_URL=""
export KEYCLOAK_BASE_URL=""

# Optional full catalog image (registry/repository:tag or @sha256:digest).
# Leave empty to use the catalog bundled with the selected Helm chart or Operator.
# It must contain dynamic-plugins.default.yaml for every requested ref:// plugin.
# Lighthouse and MCP require defaults beyond the primary RHDH index.
export CATALOG_INDEX_IMAGE="${CATALOG_INDEX_IMAGE:-}"

# Optional recorded Operator IIB and per-run RC image expectations.
export OPERATOR_IIB_IMAGE="${OPERATOR_IIB_IMAGE:-}"
export OPERATOR_EXPECTED_IMAGE="${OPERATOR_EXPECTED_IMAGE:-}"
export OPERATOR_EXPECTED_RHDH_IMAGE="${OPERATOR_EXPECTED_RHDH_IMAGE:-}"
export OPERATOR_EXPECTED_CATALOG_IMAGE="${OPERATOR_EXPECTED_CATALOG_IMAGE:-}"

# Optional Scorecard credential for private SonarQube/SonarCloud data.
# GitHub integrations use public access; GitHub tokens are not forwarded.
export SONARQUBE_API_KEY="${SONARQUBE_API_KEY:-}"

# Lightspeed / Intelligent Assistant (WITH=lightspeed)
# Enable at least one provider and set its credentials.
export ENABLE_OPENAI=""
export OPENAI_API_KEY=""
export ENABLE_VLLM=""
export VLLM_URL=""
export VLLM_API_KEY=""
export VLLM_MAX_TOKENS=""
export VLLM_TLS_VERIFY=""
export ENABLE_OLLAMA=""
export OLLAMA_URL=""
export ENABLE_VERTEX_AI=""
export VERTEX_AI_PROJECT=""
export VERTEX_AI_LOCATION=""

# Optional existing unified LCS stack file. When supplied it is used as-is.
export LIGHTSPEED_STACK_FILE=""

# MCP (Model Context Protocol) — used by Intelligent Assistant for tool access
export MCP_TOKEN=""
